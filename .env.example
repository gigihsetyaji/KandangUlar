# Ekspor variabel ini melalui shell atau secret manager; .env tidak dimuat otomatis.
KANDANGULAR_ENV=development
# Generate: kandangular secret
KANDANGULAR_SECRET_KEY=
# Token terpisah untuk API; generate dengan perintah yang sama.
KANDANGULAR_API_TOKEN=
KANDANGULAR_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
# Production: daftar origin HTTPS lengkap yang dipercaya.
KANDANGULAR_CSRF_TRUSTED_ORIGINS=
